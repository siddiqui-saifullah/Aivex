new file mode 100644
index 0000000..eb379f0
--- /dev/null
+++ b/libsrc/stdio/gets.c
@@ -0,0 +1,14 @@
+#include "stdio.h"
+
+// Removed from C11 but still common in course material; reads a line
+// without the trailing newline.
+char *gets(char *s) {
+  char *p = s;
+  int c;
+  while ((c = fgetc(stdin)) != EOF && c != '\n')
+    *p++ = c;
+  if (c == EOF && p == s)
+    return NULL;
+  *p = '\0';
+  return s;
+}
