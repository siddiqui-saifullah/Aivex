diff --git a/libsrc/math/lgamma.c b/libsrc/math/lgamma.c
new file mode 100644
index 0000000..63ade97
--- /dev/null
+++ b/libsrc/math/lgamma.c
@@ -0,0 +1,22 @@
+#include "math.h"
+
+#ifndef __NO_FLONUM
+
+// Lanczos approximation (g = 7, n = 9)
+static const double kLanczos[] = {
+  0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313,
+  -176.61502916214059, 12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6,
+  1.5056327351493116e-7,
+};
+
+double lgamma(double x) {
+  if (x < 0.5)
+    return log(M_PI / fabs(sin(M_PI * x))) - lgamma(1 - x);
+  x -= 1;
+  double a = kLanczos[0];
+  double t = x + 7.5;
+  for (int i = 1; i < 9; ++i)
+    a += kLanczos[i] / (x + i);
+  return 0.5 * log(2 * M_PI) + (x + 0.5) * log(t) - t + log(a);
+}
+#endif
