diff --git a/libsrc/misc/_time.h b/libsrc/misc/_time.h
new file mode 100644
index 0000000..eaf61fc
--- /dev/null
+++ b/libsrc/misc/_time.h
@@ -0,0 +1,20 @@
+#pragma once
+
+#include "time.h"
+
+// Days since 1970-01-01 for a proleptic Gregorian date (month 1..12).
+static inline long _days_from_civil(long y, int m, int d) {
+  y -= m <= 2;
+  long era = (y >= 0 ? y : y - 399) / 400;
+  long yoe = y - era * 400;
+  long doy = (153 * (m + (m > 2 ? -3 : 9)) + 2) / 5 + d - 1;
+  long doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
+  return era * 146097 + doe - 719468;
+}
+
+static inline int _is_leap(long y) {
+  return (y % 4 == 0 && y % 100 != 0) || y % 400 == 0;
+}
+
+extern struct tm *_time_to_tm(time_t t, long gmtoff, const char *zone, struct tm *tm);
+extern long _local_gmtoff(void);
