diff --git a/libsrc/math/cbrt.c b/libsrc/math/cbrt.c
new file mode 100644
index 0000000..3d2f6c6
--- /dev/null
+++ b/libsrc/math/cbrt.c
@@ -0,0 +1,13 @@
+#include "math.h"
+
+#ifndef __NO_FLONUM
+
+double cbrt(double x) {
+  if (x == 0 || !isfinite(x))
+    return x;
+  double a = fabs(x);
+  double r = pow(a, 1.0 / 3.0);
+  r = r - (r * r * r - a) / (3 * r * r);  // one Newton step for accuracy
+  return x < 0 ? -r : r;
+}
+#endif
