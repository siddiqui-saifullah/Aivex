diff --git a/libsrc/math/rint.c b/libsrc/math/rint.c
new file mode 100644
index 0000000..70666e3
--- /dev/null
+++ b/libsrc/math/rint.c
@@ -0,0 +1,20 @@
+#include "math.h"
+
+#ifndef __NO_FLONUM
+
+double rint(double x) {
+  // Round half to even (the default rounding mode)
+  if (!isfinite(x))
+    return x;
+  double f = floor(x);
+  double diff = x - f;
+  double r;
+  if (diff > 0.5)
+    r = f + 1;
+  else if (diff < 0.5)
+    r = f;
+  else
+    r = fmod(f, 2.0) == 0 ? f : f + 1;
+  return copysign(r, x);  // keeps -0.0 for -0.5 < x < 0
+}
+#endif
