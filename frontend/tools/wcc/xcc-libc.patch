+  tm->tm_year = (int)(y - 1900);
+  tm->tm_mon = m - 1;
+  tm->tm_mday = d;
+  tm->tm_yday = kCumDays[m - 1] + d - 1 + (m > 2 && _is_leap(y));
+  tm->tm_isdst = 0;
+  tm->tm_gmtoff = gmtoff;
+  tm->tm_zone = zone;
+  return tm;
+}
+
+struct tm *gmtime_r(const time_t *timer, struct tm *result) {
+  return _time_to_tm(*timer, 0, "UTC", result);
+}
+
+struct tm *gmtime(const time_t *timer) {
+  static struct tm tm;
+  return gmtime_r(timer, &tm);
+}
