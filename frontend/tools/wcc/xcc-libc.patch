+    saw_digits = true;
+    if (c == '0' && a.nd == 0) {  // leading zeros
+      --a.dp;
+      continue;
+    }
+    if (a.nd < DEC_MAX_DIGITS)
+      a.d[a.nd++] = (unsigned char)(c - '0');
+    else if (c != '0')
+      a.trunc = true;
+  }
+  if (!saw_digits)
+    return p;
+  if (!saw_dot)
+    a.dp = a.nd;
+  if (tolower(*s) == 'e') {
+    const char *q = s + 1;
+    bool eneg = _parse_sign(&q);
+    if (*q >= '0' && *q <= '9') {
+      long e = 0;
