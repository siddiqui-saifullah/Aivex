diff --git a/libsrc/misc/localtime.c b/libsrc/misc/localtime.c
new file mode 100644
index 0000000..edceabd
--- /dev/null
+++ b/libsrc/misc/localtime.c
@@ -0,0 +1,19 @@
+#include "time.h"
+#include "stdlib.h"
+#include "_time.h"
+
+// The browser passes its UTC offset in minutes (east positive) in TZOFFSET.
+long _local_gmtoff(void) {
+  const char *s = getenv("TZOFFSET");
+  return s != NULL ? strtol(s, NULL, 10) * 60 : 0;
+}
+
+struct tm *localtime_r(const time_t *timer, struct tm *result) {
+  long off = _local_gmtoff();
+  return _time_to_tm(*timer, off, off == 0 ? "UTC" : "", result);
+}
+
+struct tm *localtime(const time_t *timer) {
+  static struct tm tm;
+  return localtime_r(timer, &tm);
+}
diff --git a/libsrc/misc/mktime.c b/libsrc/misc/mktime.c
new file mode 100644
index 0000000..0d8bf71
--- /dev/null
+++ b/libsrc/misc/mktime.c
@@ -0,0 +1,25 @@
+#include "time.h"
+#include "_time.h"
+
+static time_t normalize(struct tm *tm, long gmtoff, const char *zone) {
+  // Fold out-of-range months into years first; the rest is linear.
+  long y = 1900L + tm->tm_year + tm->tm_mon / 12;
+  int m = tm->tm_mon % 12;
+  if (m < 0) {
+    m += 12;
+    --y;
+  }
+  long days = _days_from_civil(y, m + 1, 1) + tm->tm_mday - 1;
+  time_t t = days * 86400 + tm->tm_hour * 3600L + tm->tm_min * 60L + tm->tm_sec - gmtoff;
+  _time_to_tm(t, gmtoff, zone, tm);
+  return t;
+}
+
+time_t mktime(struct tm *tm) {
+  long off = _local_gmtoff();
+  return normalize(tm, off, off == 0 ? "UTC" : "");
+}
+
+time_t timegm(struct tm *tm) {
+  return normalize(tm, 0, "UTC");
+}
diff --git a/libsrc/misc/strftime.c b/libsrc/misc/strftime.c
new file mode 100644
index 0000000..e24906b
--- /dev/null
+++ b/libsrc/misc/strftime.c
@@ -0,0 +1,94 @@
+#include "time.h"
+#include "stdio.h"
+#include "string.h"
+
+static const char *const kWday[] = {"Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"};
+static const char *const kMon[] = {"January", "February", "March", "April", "May", "June", "July",
+                                   "August", "September", "October", "November", "December"};
+
+static int wday_ok(const struct tm *tm) { return tm->tm_wday >= 0 && tm->tm_wday < 7; }
+static int mon_ok(const struct tm *tm) { return tm->tm_mon >= 0 && tm->tm_mon < 12; }
+
+size_t strftime(char *s, size_t max, const char *format, const struct tm *tm) {
+  size_t n = 0;
+  char tmp[64];
+  for (const char *p = format; *p != '\0'; ++p) {
+    const char *out = tmp;
+    if (*p != '%') {
+      tmp[0] = *p;
+      tmp[1] = '\0';
+    } else {
+      ++p;
+      while (*p == 'E' || *p == 'O')
+        ++p;
+      int hour12 = tm->tm_hour % 12 == 0 ? 12 : tm->tm_hour % 12;
+      switch (*p) {
+      case 'a': out = wday_ok(tm) ? kWday[tm->tm_wday] : "?"; snprintf(tmp, 4, "%s", out); out = tmp; break;
+      case 'A': out = wday_ok(tm) ? kWday[tm->tm_wday] : "?"; break;
+      case 'b': case 'h': out = mon_ok(tm) ? kMon[tm->tm_mon] : "?"; snprintf(tmp, 4, "%s", out); out = tmp; break;
+      case 'B': out = mon_ok(tm) ? kMon[tm->tm_mon] : "?"; break;
+      case 'c': {
+        char a[8], b[8];
+        strftime(a, sizeof(a), "%a", tm);
+        strftime(b, sizeof(b), "%b", tm);
+        snprintf(tmp, sizeof(tmp), "%s %s %2d %02d:%02d:%02d %d", a, b, tm->tm_mday, tm->tm_hour,
+                 tm->tm_min, tm->tm_sec, tm->tm_year + 1900);
+        break;
+      }
+      case 'C': snprintf(tmp, sizeof(tmp), "%02d", (tm->tm_year + 1900) / 100); break;
+      case 'd': snprintf(tmp, sizeof(tmp), "%02d", tm->tm_mday); break;
+      case 'D': snprintf(tmp, sizeof(tmp), "%02d/%02d/%02d", tm->tm_mon + 1, tm->tm_mday, (tm->tm_year + 1900) % 100); break;
+      case 'e': snprintf(tmp, sizeof(tmp), "%2d", tm->tm_mday); break;
+      case 'F': snprintf(tmp, sizeof(tmp), "%d-%02d-%02d", tm->tm_year + 1900, tm->tm_mon + 1, tm->tm_mday); break;
+      case 'H': snprintf(tmp, sizeof(tmp), "%02d", tm->tm_hour); break;
+      case 'I': snprintf(tmp, sizeof(tmp), "%02d", hour12); break;
+      case 'j': snprintf(tmp, sizeof(tmp), "%03d", tm->tm_yday + 1); break;
+      case 'k': snprintf(tmp, sizeof(tmp), "%2d", tm->tm_hour); break;
+      case 'l': snprintf(tmp, sizeof(tmp), "%2d", hour12); break;
+      case 'm': snprintf(tmp, sizeof(tmp), "%02d", tm->tm_mon + 1); break;
+      case 'M': snprintf(tmp, sizeof(tmp), "%02d", tm->tm_min); break;
+      case 'n': out = "\n"; break;
+      case 'p': out = tm->tm_hour < 12 ? "AM" : "PM"; break;
+      case 'P': out = tm->tm_hour < 12 ? "am" : "pm"; break;
+      case 'r': snprintf(tmp, sizeof(tmp), "%02d:%02d:%02d %s", hour12, tm->tm_min, tm->tm_sec, tm->tm_hour < 12 ? "AM" : "PM"); break;
+      case 'R': snprintf(tmp, sizeof(tmp), "%02d:%02d", tm->tm_hour, tm->tm_min); break;
+      case 'S': snprintf(tmp, sizeof(tmp), "%02d", tm->tm_sec); break;
+      case 't': out = "\t"; break;
+      case 'T': snprintf(tmp, sizeof(tmp), "%02d:%02d:%02d", tm->tm_hour, tm->tm_min, tm->tm_sec); break;
+      case 'u': snprintf(tmp, sizeof(tmp), "%d", tm->tm_wday == 0 ? 7 : tm->tm_wday); break;
+      case 'U': snprintf(tmp, sizeof(tmp), "%02d", (tm->tm_yday + 7 - tm->tm_wday) / 7); break;
+      case 'W': snprintf(tmp, sizeof(tmp), "%02d", (tm->tm_yday + 7 - (tm->tm_wday + 6) % 7) / 7); break;
+      case 'w': snprintf(tmp, sizeof(tmp), "%d", tm->tm_wday); break;
+      case 'x': snprintf(tmp, sizeof(tmp), "%02d/%02d/%02d", tm->tm_mon + 1, tm->tm_mday, (tm->tm_year + 1900) % 100); break;
+      case 'X': snprintf(tmp, sizeof(tmp), "%02d:%02d:%02d", tm->tm_hour, tm->tm_min, tm->tm_sec); break;
+      case 'y': snprintf(tmp, sizeof(tmp), "%02d", (tm->tm_year + 1900) % 100); break;
+      case 'Y': snprintf(tmp, sizeof(tmp), "%d", tm->tm_year + 1900); break;
+      case 'z': {
+        long off = tm->tm_gmtoff / 60;
+        char sign = off < 0 ? '-' : '+';
+        if (off < 0) off = -off;
+        snprintf(tmp, sizeof(tmp), "%c%02ld%02ld", sign, off / 60, off % 60);
+        break;
+      }
+      case 'Z': out = tm->tm_zone != NULL ? tm->tm_zone : ""; break;
+      case 's': {
+        struct tm copy = *tm;
+        snprintf(tmp, sizeof(tmp), "%ld", (long)mktime(&copy));
+        break;
+      }
+      case '%': out = "%"; break;
+      case '\0': --p; out = ""; break;
+      default: tmp[0] = '%'; tmp[1] = *p; tmp[2] = '\0'; break;
+      }
+    }
+    size_t len = strlen(out);
+    if (n + len >= max)
+      return 0;
+    memcpy(s + n, out, len);
+    n += len;
+  }
+  if (n >= max)
+    return 0;
+  s[n] = '\0';
+  return n;
+}
