+// Correctly rounded decimal -> double (port of Go's strconv "decimal" algorithm):
+// the decimal digits are scaled by powers of two until they fall in [0.5, 1),
+// then the 53-bit mantissa is taken with round-half-to-even.
+
+#define DEC_MAX_DIGITS  (800)
+
+typedef struct {
+  unsigned char d[DEC_MAX_DIGITS];  // digits, big-endian, values 0..9
+  int nd;    // number of digits used
+  int dp;    // decimal point
+  bool trunc;  // discarded nonzero digits beyond d[:nd]
+} Decimal;
+
+static void dec_trim(Decimal *a) {
+  while (a->nd > 0 && a->d[a->nd - 1] == 0)
+    --a->nd;
+  if (a->nd == 0)
+    a->dp = 0;
+}
+
+static void dec_right_shift(Decimal *a, unsigned k) {
+  int r = 0, w = 0;
+  uint64_t n = 0;
+  for (; (n >> k) == 0; ++r) {
+    if (r >= a->nd) {
+      if (n == 0) {
+        a->nd = 0;
+        return;
+      }
+      while ((n >> k) == 0) {
+        n *= 10;
+        ++r;
+      }
+      break;
+    }
+    n = n * 10 + a->d[r];
+  }
+  a->dp -= r - 1;
+  uint64_t mask = ((uint64_t)1 << k) - 1;
+  for (; r < a->nd; ++r) {
+    unsigned c = a->d[r];
+    unsigned dig = (unsigned)(n >> k);
+    n &= mask;
+    a->d[w++] = (unsigned char)dig;
+    n = n * 10 + c;
+  }
+  while (n > 0) {
+    unsigned dig = (unsigned)(n >> k);
+    n &= mask;
+    if (w < DEC_MAX_DIGITS)
+      a->d[w++] = (unsigned char)dig;
+    else if (dig > 0)
+      a->trunc = true;
+    n *= 10;
+  }
+  a->nd = w;
+  dec_trim(a);
+}
+
+static void dec_left_shift(Decimal *a, unsigned k) {
+  unsigned char tmp[DEC_MAX_DIGITS + 32];
+  int w = (int)sizeof(tmp);
+  uint64_t n = 0;
+  for (int r = a->nd - 1; r >= 0; --r) {
+    n += (uint64_t)a->d[r] << k;
+    tmp[--w] = (unsigned char)(n % 10);
+    n /= 10;
+  }
+  while (n > 0) {
+    tmp[--w] = (unsigned char)(n % 10);
+    n /= 10;
+  }
+  int len = (int)sizeof(tmp) - w;
+  a->dp += len - a->nd;
+  if (len > DEC_MAX_DIGITS) {
+    for (int i = DEC_MAX_DIGITS; i < len; ++i)
+      if (tmp[w + i] != 0)
+        a->trunc = true;
+    len = DEC_MAX_DIGITS;
+  }
+  memcpy(a->d, tmp + w, len);
+  a->nd = len;
+  dec_trim(a);
+}
+
+static void dec_shift(Decimal *a, int k) {
+  const int MAX_SHIFT = 60;
+  if (a->nd == 0)
+    return;
+  if (k > 0) {
+    for (; k > MAX_SHIFT; k -= MAX_SHIFT)
+      dec_left_shift(a, MAX_SHIFT);
+    dec_left_shift(a, (unsigned)k);
+  } else if (k < 0) {
+    for (; k < -MAX_SHIFT; k += MAX_SHIFT)
+      dec_right_shift(a, MAX_SHIFT);
+    dec_right_shift(a, (unsigned)-k);
+  }
+}
+
+static bool dec_should_round_up(const Decimal *a, int nd) {
+  if (nd < 0 || nd >= a->nd)
+    return false;
+  if (a->d[nd] == 5 && nd + 1 == a->nd) {  // exactly halfway: round to even
+    if (a->trunc)
+      return true;
+    return nd > 0 && (a->d[nd - 1] % 2) != 0;
+  }
+  return a->d[nd] >= 5;
+}
+
+static uint64_t dec_rounded_integer(const Decimal *a) {
+  if (a->dp > 20)
+    return ~(uint64_t)0;
+  int i;
+  uint64_t n = 0;
+  for (i = 0; i < a->dp && i < a->nd; ++i)
+    n = n * 10 + a->d[i];
+  for (; i < a->dp; ++i)
+    n *= 10;
+  if (dec_should_round_up(a, a->dp))
+    ++n;
+  return n;
+}
+
+static double dec_to_double(Decimal *a, bool *overflow) {
+  static const int POWTAB[] = {1, 3, 6, 9, 13, 16, 19, 23, 26};
+  const int NPOW = (int)(sizeof(POWTAB) / sizeof(POWTAB[0]));
+  const int BIAS = -1023, MANTBITS = 52;
+  int exp = 0;
+  uint64_t mant;
+  union { double d; uint64_t u; } bits;
+  *overflow = false;
+
+  if (a->nd == 0) {
+    mant = 0;
+    exp = BIAS;
+    goto out;
+  }
+  if (a->dp > 310)
+    goto overflow;
+  if (a->dp < -330) {
+    mant = 0;
+    exp = BIAS;
+    goto out;
+  }
+  while (a->dp > 0) {
+    int n = a->dp >= NPOW ? 27 : POWTAB[a->dp];
+    dec_shift(a, -n);
+    exp += n;
+  }
+  while (a->dp < 0 || (a->dp == 0 && a->d[0] < 5)) {
+    int n = -a->dp >= NPOW ? 27 : POWTAB[-a->dp];
+    dec_shift(a, n);
+    exp -= n;
+  }
+  // [0.5, 1) -> [1, 2)
+  --exp;
+  if (exp < BIAS + 1) {  // denormal
+    int n = BIAS + 1 - exp;
+    dec_shift(a, -n);
+    exp += n;
+  }
+  if (exp - BIAS >= (1 << 11) - 1)
+    goto overflow;
+  dec_shift(a, 1 + MANTBITS);
+  mant = dec_rounded_integer(a);
+  if (mant == ((uint64_t)2 << MANTBITS)) {  // rounding carried
+    mant >>= 1;
+    ++exp;
+    if (exp - BIAS >= (1 << 11) - 1)
+      goto overflow;
+  }
+  if ((mant & ((uint64_t)1 << MANTBITS)) == 0)
+    exp = BIAS;
+  goto out;
+
+overflow:
+  mant = 0;
+  exp = (1 << 11) - 1 + BIAS;
+  *overflow = true;
+
+out:
+  bits.u = (mant & (((uint64_t)1 << MANTBITS) - 1)) | ((uint64_t)((exp - BIAS) & 0x7ff) << MANTBITS);
+  return bits.d;
+}
+
+// Parse "digits[.digits][e[+-]digits]" at p. Returns the end, or p if no digits.
+static const char *strtod_decimal(const char *p, double *result) {
+  static Decimal a;  // large: keep it off the (small) stack
+  a.nd = 0;
+  a.dp = 0;
+  a.trunc = false;
+  bool saw_dot = false, saw_digits = false;
+  const char *s = p;
+  for (;; ++s) {
+    char c = *s;
+    if (c == '.') {
+      if (saw_dot)
+        break;
+      saw_dot = true;
+      a.dp = a.nd;
+      continue;
+    }
+    if (c < '0' || c > '9')
