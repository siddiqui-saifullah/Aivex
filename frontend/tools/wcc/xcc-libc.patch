diff --git a/libsrc/_wasm/unistd/clock.c b/libsrc/_wasm/unistd/clock.c
new file mode 100644
index 0000000..0a7eb41
--- /dev/null
+++ b/libsrc/_wasm/unistd/clock.c
@@ -0,0 +1,18 @@
+#include "time.h"
+#include "stdint.h"
+#include "../wasi.h"
+
+static uint64_t start_ns;
+
+__attribute__((constructor))
+static void init_clock(void) {
+  clock_time_get(CLOCK_MONOTONIC, 1, &start_ns);
+}
+
+// The sandbox has no CPU-time clock, so this is the time since the program
+// started (close to CPU time for programs that are not waiting for input).
+clock_t clock(void) {
+  uint64_t now;
+  clock_time_get(CLOCK_MONOTONIC, 1, &now);
+  return (clock_t)((now - start_ns) / (1000000000ULL / CLOCKS_PER_SEC));
+}
diff --git a/libsrc/_wasm/unistd/signal.c b/libsrc/_wasm/unistd/signal.c
new file mode 100644
index 0000000..6bfee6b
--- /dev/null
+++ b/libsrc/_wasm/unistd/signal.c
@@ -0,0 +1,34 @@
+// signal()/raise() for the browser sandbox: there are no asynchronous
+// signals, but programs can install handlers and raise() them.
+#include "signal.h"
+#include "stdio.h"
+#include "stddef.h"  // NULL
+#include "../wasi.h"
+
+#define NSIG_  32
+
+static void (*handlers[NSIG_])(int);
+
+void (*signal(int sig, void (*func)(int)))(int) {
+  if (sig <= 0 || sig >= NSIG_ || sig == SIGKILL || sig == SIGSTOP)
+    return SIG_ERR;
+  void (*old)(int) = handlers[sig];
+  handlers[sig] = func;
+  return old;
+}
+
+int raise(int sig) {
+  if (sig <= 0 || sig >= NSIG_)
+    return -1;
+  void (*func)(int) = handlers[sig];
+  if (func == SIG_IGN)
+    return 0;
+  if (func == SIG_DFL) {
+    if (sig == SIGCHLD || sig == SIGURG || sig == SIGWINCH || sig == SIGCONT)
+      return 0;
+    fflush(stdout);
+    proc_exit(128 + sig);
+  }
+  func(sig);
+  return 0;
+}
diff --git a/libsrc/_wasm/unistd/sleep.c b/libsrc/_wasm/unistd/sleep.c
new file mode 100644
index 0000000..84f9651
--- /dev/null
+++ b/libsrc/_wasm/unistd/sleep.c
@@ -0,0 +1,60 @@
+// sleep/usleep/nanosleep via a WASI clock subscription.
+#include "unistd.h"
+#include "time.h"
+#include "errno.h"
+#include "stdio.h"
+#include "stdint.h"
+#include "../wasi.h"
+
+typedef struct {
+  uint64_t userdata;
+  uint8_t tag;  // 0: clock
+  uint8_t pad[7];
+  uint32_t clock_id;
+  uint32_t pad2;
+  uint64_t timeout;
+  uint64_t precision;
+  uint16_t flags;
+  uint8_t pad3[6];
+} Subscription;
+
+typedef struct {
+  uint64_t userdata;
+  uint16_t error;
+  uint8_t type;
+  uint8_t pad[21];
+} Event;
+
+WASI_MODULE int poll_oneoff(const Subscription *in, Event *out, size_t nsubscriptions, size_t *nevents);
+
+static void sleep_ns(uint64_t ns) {
+  fflush(stdout);  // show what was printed before pausing
+  Subscription sub = {0};
+  sub.tag = 0;
+  sub.clock_id = CLOCK_MONOTONIC;
+  sub.timeout = ns;
+  Event ev;
+  size_t n;
+  poll_oneoff(&sub, &ev, 1, &n);
+}
+
+unsigned int sleep(unsigned int seconds) {
+  sleep_ns((uint64_t)seconds * 1000000000ULL);
+  return 0;
+}
+
+int usleep(unsigned int usec) {
+  sleep_ns((uint64_t)usec * 1000ULL);
+  return 0;
+}
+
+int nanosleep(const struct timespec *req, struct timespec *rem) {
+  if (req == NULL || req->tv_nsec < 0 || req->tv_nsec >= 1000000000L) {
+    errno = EINVAL;
+    return -1;
+  }
+  sleep_ns((uint64_t)req->tv_sec * 1000000000ULL + req->tv_nsec);
+  if (rem != NULL)
+    rem->tv_sec = rem->tv_nsec = 0;
+  return 0;
+}
