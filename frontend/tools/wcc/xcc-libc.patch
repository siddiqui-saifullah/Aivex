+#include "string.h"
+
+// Only the "C" locale exists, so the transform is a plain copy.
+size_t strxfrm(char *dst, const char *src, size_t n) {
+  size_t len = strlen(src);
+  if (n > 0) {
+    size_t m = len < n - 1 ? len : n - 1;
+    memcpy(dst, src, m);
+    dst[m] = '\0';
+  }
+  return len;
+}
