diff --git a/libsrc/math/erf.c b/libsrc/math/erf.c
new file mode 100644
index 0000000..1486f78
--- /dev/null
+++ b/libsrc/math/erf.c
@@ -0,0 +1,26 @@
+#include "math.h"
+
+#ifndef __NO_FLONUM
+
+double erf(double x) {
+  // Abramowitz & Stegun 7.1.26 refined with a series near 0
+  double ax = fabs(x);
+  double r;
+  if (ax < 0.5) {
+    double x2 = x * x, term = x, sum = x;
+    for (int n = 1; n < 30; ++n) {
+      term *= -x2 / n;
+      double add = term / (2 * n + 1);
+      sum += add;
+      if (fabs(add) < 1e-17)
+        break;
+    }
+    return sum * 1.1283791670955126;  // 2/sqrt(pi)
+  }
+  double t = 1.0 / (1.0 + 0.3275911 * ax);
+  double y = 1.0 - (((((1.061405429 * t - 1.453152027) * t) + 1.421413741) * t - 0.284496736) * t +
+                    0.254829592) * t * exp(-ax * ax);
+  r = y;
+  return x < 0 ? -r : r;
+}
+#endif
