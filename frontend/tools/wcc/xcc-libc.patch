diff --git a/libsrc/math/hypot.c b/libsrc/math/hypot.c
new file mode 100644
index 0000000..9d49ab9
--- /dev/null
+++ b/libsrc/math/hypot.c
@@ -0,0 +1,18 @@
+#include "math.h"
+
+#ifndef __NO_FLONUM
+
+double hypot(double x, double y) {
+  x = fabs(x);
+  y = fabs(y);
+  if (isinf(x) || isinf(y))
+    return INFINITY;
+  if (x < y) {
+    double t = x; x = y; y = t;
+  }
+  if (x == 0)
+    return 0;
+  double r = y / x;  // scaled to avoid overflow
+  return x * sqrt(1 + r * r);
+}
+#endif
