+      a.dp += eneg ? -(int)e : (int)e;
+      s = q;
+    }
+  }
+  dec_trim(&a);
+  bool overflow;
+  *result = dec_to_double(&a, &overflow);
+  if (overflow)
+    errno = ERANGE;
+  return s;
+}
